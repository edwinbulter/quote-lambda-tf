# Get master key
# az functionapp keys list --resource-group quote-backend-rg --name quote-backend-function --query "masterKey"
# Or get specific function keys
# az functionapp function keys list --resource-group quote-backend-rg --name quote-backend-function --function-name QuoteHandler

# Note: FUNCTION_KEY variable is defined in http-client.env.json in the same directory (not committed to git)
# Create this file with your actual function keys to test the endpoints

# This only works in Intellij and you need to set the environment. VS Code does not translate the {{FUNCTION_KEY}} variable.

### Get Quote
GET https://quote-backend-function.azurewebsites.net/api/quotes?code={{FUNCTION_KEY}}

### Get random Quote
GET https://quote-backend-function.azurewebsites.net/api/quote/random?code={{FUNCTION_KEY}}

### Get Quote by Id
GET https://quote-backend-function.azurewebsites.net/api/quote/1?code={{FUNCTION_KEY}}

### Like Quote
POST https://quote-backend-function.azurewebsites.net/api/quotes/1/like?code={{FUNCTION_KEY}}

### System Status
GET https://quote-backend-function.azurewebsites.net/api/system/status?code={{FUNCTION_KEY}}